{
  "name": "science-intro",
  "version": "1.0.0",
  "description": "Intro animasi universal untuk video edukasi sains — SCIENTIAN · Explore Science with Yayan",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "lint": "tsc --noEmit",
    "audio": "python3 scripts/make-intro-audio.py",
    "stills": "node scripts/stills.mjs",
    "render": "remotion render src/index.ts Intro2K out/scientian-intro-2k-30fps.mp4 --codec=h264 --crf=16",
    "render:60": "remotion render src/index.ts Intro2K60 out/scientian-intro-2k-60fps.mp4 --codec=h264 --crf=16",
    "render:1080": "remotion render src/index.ts Intro out/scientian-intro-1080p-30fps.mp4 --codec=h264 --crf=17",
    "logo": "remotion still src/index.ts Logo out/scientian-logo-transparan.png --image-format=png"
  },
  "dependencies": {
    "remotion": "4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/media": "4.0.536",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@fontsource/outfit": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "19.2.7",
    "@remotion/bundler": "4.0.536",
    "@remotion/renderer": "4.0.536"
  }
}
